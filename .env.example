# ── Environment ──────────────────────────────────────────────────────────────
POSTGRES_USER=scscs
POSTGRES_PASSWORD=scscs
POSTGRES_DB=scscs
DATABASE_URL=postgresql+asyncpg://scscs:scscs@db:5432/scscs

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# ── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
APP_ENV=production
